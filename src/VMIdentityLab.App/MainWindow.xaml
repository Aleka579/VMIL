<Window x:Class="VMIdentityLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:VMIdentityLab.App.Infrastructure"
        Title="VM Identity Lab" Width="1220" Height="800" MinWidth="1020" MinHeight="680"
        Background="#F3F6FB" Foreground="#193452" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.Resources><infra:PageVisibilityConverter x:Key="PageVisibility" /></Window.Resources>
    <Grid x:Name="RootContent" Background="#F3F6FB">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#152D49" Padding="20,30">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
                    <Border Background="#2A72C7" CornerRadius="11" Width="50" Height="50" HorizontalAlignment="Left">
                        <TextBlock Text="VM" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Identity Lab" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,5" />
                    <TextBlock Text="{DynamicResource App.Subtitle}" Foreground="#9FB5CF" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <TextBlock Text="{DynamicResource State.ReadOnly}" Foreground="#91BFEB" FontSize="11" Margin="0,0,0,12" />
                    <ComboBox x:Name="LanguageSelector" SelectedIndex="0" SelectionChanged="LanguageChanged" Padding="8,6" FontSize="12">
                        <ComboBoxItem Content="简体中文" /><ComboBoxItem Content="English" />
                    </ComboBox>
                </StackPanel>
                <ListBox SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" FontSize="14">
                    <ListBoxItem Content="{DynamicResource Nav.Overview}" />
                    <ListBoxItem Content="{DynamicResource Nav.Detection}" />
                    <ListBoxItem Content="{DynamicResource Nav.Configuration}" />
                    <ListBoxItem Content="{DynamicResource Nav.Comparison}" />
                    <ListBoxItem Content="{DynamicResource Nav.Reports}" />
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{DynamicResource Action.OpenVmx}" Command="{Binding OpenVmxCommand}" />
                    <Button Content="{DynamicResource Action.Collect}" Command="{Binding CollectCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{DynamicResource Action.Cancel}" Command="{Binding CancelCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Overview.Title}" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Overview.Description}" Style="{StaticResource Muted}" Margin="0,0,0,24" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Overview.System}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding OsText}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BuildText}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Overview.Evidence}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding EvidenceText}" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Overview.EvidenceNote}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="{DynamicResource Overview.Available}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding CountsText}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel><TextBlock Text="{DynamicResource Overview.Hypervisor}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding HypervisorText}" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="{DynamicResource Overview.Workflow}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12" /><TextBlock Text="{DynamicResource Overview.WorkflowText}" Style="{StaticResource Muted}" /></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18"><Button Content="{DynamicResource Action.ImportLeft}" Command="{Binding ImportLeftCommand}" DockPanel.Dock="Right" /><TextBlock Text="{DynamicResource Detection.Description}" Style="{StaticResource Muted}" /></DockPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <DataGrid x:Name="FindingsTable" ItemsSource="{Binding Findings}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column.Category}" Binding="{Binding Category}" Width="75" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name}" Width="175" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Value}" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Status}" Binding="{Binding Status}" Width="105" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Source}" Binding="{Binding Source}" Width="210" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Explanation}" /></Style></DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=2}"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Configuration.Description}" Style="{StaticResource Muted}" Margin="0,0,0,18" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{Binding VmxStateText}" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,8" /><TextBlock Text="{Binding VmxNotice}" Style="{StaticResource Muted}" /><Button Content="{DynamicResource Action.ReadPower}" Command="{Binding ReadPowerCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel></Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Config.Title}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ConfigNotice}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Config.Memory}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="CandidateMemory" Grid.Column="1" Text="{Binding RequestedMemory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" Padding="7,5" Margin="0,0,18,0" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Config.Cpu}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="CandidateCpu" Grid.Column="3" Text="{Binding RequestedCpu, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" Padding="7,5" Margin="0,0,18,0" />
                            <Button Grid.Column="4" Content="{DynamicResource Config.Preview}" Command="{Binding PreviewConfigCommand}" Margin="0" />
                        </Grid>
                        <DataGrid x:Name="ConfigPreviewTable" ItemsSource="{Binding ConfigChanges}" MaxHeight="120">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Impact}" /></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Column.Key}" Binding="{Binding Key}" Width="150" />
                                <DataGridTextColumn Header="{DynamicResource Config.Before}" Binding="{Binding Before}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Config.After}" Binding="{Binding After}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Config.Impact}" Binding="{Binding Impact}" Width="*" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button x:Name="ReviewConfigButton" Content="{DynamicResource Config.Review}" Command="{Binding ReviewConfigCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding UnsavedHistoryWarning}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Expander x:Name="BackupHistoryExpander" Grid.Row="3" Header="{DynamicResource History.Title}" Margin="0,0,0,12">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding HistoryNotice}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <DataGrid x:Name="BackupHistoryTable" ItemsSource="{Binding BackupHistory}" SelectedItem="{Binding SelectedBackup}" MaxHeight="120">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Backup}" /></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource History.Time}" Binding="{Binding Time}" Width="180" />
                                <DataGridTextColumn Header="{DynamicResource History.Target}" Binding="{Binding Target}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource History.Operation}" Binding="{Binding Operation}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,8">
                            <Button Content="{DynamicResource History.Reload}" Command="{Binding LoadHistoryCommand}" />
                            <Button Content="{DynamicResource History.PreviewRestore}" Command="{Binding PreviewRestoreCommand}" />
                            <Button Content="{DynamicResource History.Save}" Command="{Binding SaveHistoryCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource History.Location}" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding RecoveryLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="65" />
                    </StackPanel>
                </Expander>
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="VmxTable" ItemsSource="{Binding VmxRows}" MaxHeight="280"><DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Column.Key}" Binding="{Binding Key}" Width="230" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Value}" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Support}" Binding="{Binding Support}" Width="280" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns></DataGrid></Border>
            </Grid></ScrollViewer>
            <Grid Grid.Row="1" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Comparison.Description}" Style="{StaticResource Muted}" Margin="0,0,0,18" />
                <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><Button Content="{DynamicResource Action.ImportLeft}" Command="{Binding ImportLeftCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding LeftText}" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><Button Content="{DynamicResource Action.ImportRight}" Command="{Binding ImportRightCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding RightText}" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="DifferencesTable" ItemsSource="{Binding Differences}"><DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name}" Width="175" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Left}" Binding="{Binding Left}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Right}" Binding="{Binding Right}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Result}" Binding="{Binding Result}" Width="130" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Reason}" Binding="{Binding Reason}" Width="160" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns></DataGrid></Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=4}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Reports.Description}" Style="{StaticResource Muted}" Margin="0,0,0,22" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource Reports.Format}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,10" /><TextBlock Text="{Binding ReportDetails}" Style="{StaticResource Muted}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource Reports.Json}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" /><Button Content="{DynamicResource Action.ExportJson}" Command="{Binding ExportJsonCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource Reports.Html}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" /><Button Content="{DynamicResource Action.ExportHtml}" Command="{Binding ExportHtmlCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Reports.Privacy}" FontWeight="SemiBold" Margin="0,0,0,10" /><TextBlock Text="{DynamicResource Reports.PrivacyText}" Style="{StaticResource Muted}" /></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#DEE6F0" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0">
                <DockPanel><TextBlock Text="{Binding ApplicationVersion}" Foreground="#8798AD" FontSize="11" DockPanel.Dock="Right" /><TextBlock Text="{Binding StatusText}" Foreground="#62748B" FontSize="12" TextWrapping="Wrap" /></DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
