<Window x:Class="VMIdentityLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:VMIdentityLab.App.Infrastructure"
        Title="VM Identity Lab" Width="1220" Height="800" MinWidth="1020" MinHeight="680"
        Background="#F3F6FB" Foreground="#193452" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.Resources><infra:PageVisibilityConverter x:Key="PageVisibility" /></Window.Resources>
    <Grid x:Name="RootContent" Background="#F3F6FB">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#152D49" Padding="20,30">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
                    <Border Background="#2A72C7" CornerRadius="11" Width="50" Height="50" HorizontalAlignment="Left">
                        <TextBlock Text="VM" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Identity Lab" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,5" />
                    <TextBlock Text="{DynamicResource App.Subtitle}" Foreground="#9FB5CF" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <TextBlock Text="{DynamicResource State.ReadOnly}" Foreground="#91BFEB" FontSize="11" Margin="0,0,0,12" />
                    <ComboBox x:Name="LanguageSelector" SelectedIndex="0" SelectionChanged="LanguageChanged" Padding="8,6" FontSize="12">
                        <ComboBoxItem Content="简体中文" /><ComboBoxItem Content="English" />
                    </ComboBox>
                </StackPanel>
                <ListBox SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" FontSize="14">
                    <ListBoxItem Content="{DynamicResource Nav.Overview}" />
                    <ListBoxItem Content="{DynamicResource Nav.Detection}" />
                    <ListBoxItem Content="{DynamicResource Nav.Configuration}" />
                    <ListBoxItem Content="{DynamicResource Nav.Comparison}" />
                    <ListBoxItem Content="{DynamicResource Nav.Reports}" />
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{DynamicResource Action.OpenVmx}" Command="{Binding OpenVmxCommand}" />
                    <Button Content="{DynamicResource Action.Collect}" Command="{Binding CollectCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{DynamicResource Action.Cancel}" Command="{Binding CancelCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Overview.Title}" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Overview.Description}" Style="{StaticResource Muted}" Margin="0,0,0,24" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Overview.System}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding OsText}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BuildText}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Overview.Evidence}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding EvidenceText}" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Overview.EvidenceNote}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="{DynamicResource Overview.Available}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding CountsText}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel><TextBlock Text="{DynamicResource Overview.Hypervisor}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding HypervisorText}" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="{DynamicResource Overview.Workflow}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12" /><TextBlock Text="{DynamicResource Overview.WorkflowText}" Style="{StaticResource Muted}" /></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10"><Button Content="{DynamicResource Action.ImportLeft}" Command="{Binding ImportLeftCommand}" DockPanel.Dock="Right" /><TextBlock Text="{DynamicResource Detection.Description}" Style="{StaticResource Muted}" /></DockPanel>
                <CheckBox x:Name="IncludeIdentifiersCheckBox" Grid.Row="1" Content="{DynamicResource Identity.IncludeIdentifiers}" IsChecked="{Binding IncludeIdentifiers}"
                          IsEnabled="{Binding CanChooseIdentifiers}" Margin="0,0,0,12" ToolTip="{DynamicResource Identity.Privacy}" />
                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                <TabItem Header="{DynamicResource Identity.Observations}">
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <DataGrid x:Name="FindingsTable" ItemsSource="{Binding Findings}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column.Category}" Binding="{Binding Category}" Width="75" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name}" Width="175" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Value}" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Status}" Binding="{Binding Status}" Width="105" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{DynamicResource Column.Source}" Binding="{Binding Source}" Width="210" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Explanation}" /></Style></DataGrid.RowStyle>
                    </DataGrid>
                </Border>
                </TabItem>
                <TabItem x:Name="IdentityAnalysisTab" Header="{DynamicResource Identity.Title}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Identity.Description}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                        <DataGrid x:Name="IdentityTable" Grid.Row="1" ItemsSource="{Binding IdentityRows}" SelectedItem="{Binding SelectedIdentity}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{DynamicResource Identity.Declaration}" Binding="{Binding Declaration}" Width="145" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{DynamicResource Identity.Observation}" Binding="{Binding Observation}" Width="130" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{DynamicResource Column.Status}" Binding="{Binding Status}" Width="95" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{DynamicResource Identity.WriteSupport}" Binding="{Binding Support}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedIdentity.Source}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding SelectedIdentity.Time}" Style="{StaticResource Muted}" Margin="0,4,0,4" />
                                <TextBlock Text="{Binding SelectedIdentity.Basis}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                </TabControl>
            </Grid>
            <ScrollViewer x:Name="ConfigurationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=2}"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Configuration.Description}" Style="{StaticResource Muted}" Margin="0,0,0,18" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{Binding VmxStateText}" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,8" /><TextBlock Text="{Binding VmxNotice}" Style="{StaticResource Muted}" /><Button Content="{DynamicResource Action.ReadPower}" Command="{Binding ReadPowerCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel></Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Config.Title}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ConfigNotice}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Config.Memory}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="CandidateMemory" Grid.Column="1" Text="{Binding RequestedMemory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" Padding="7,5" Margin="0,0,18,0" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Config.Cpu}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="CandidateCpu" Grid.Column="3" Text="{Binding RequestedCpu, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" Padding="7,5" Margin="0,0,18,0" />
                            <Button Grid.Column="4" Content="{DynamicResource Config.Preview}" Command="{Binding PreviewConfigCommand}" Margin="0" />
                        </Grid>
                        <TextBlock Text="{Binding IdentityConfigScope}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <WrapPanel Margin="0,0,0,12">
                            <ComboBox x:Name="IdentityConfigSelector" SelectedIndex="{Binding SelectedIdentityFieldIndex}" IsEnabled="{Binding CanChooseIdentifiers}" MinWidth="230" Padding="7,5" Margin="0,0,12,8">
                                <ComboBoxItem Content="{DynamicResource IdentityConfig.Mac}" />
                                <ComboBoxItem Content="{DynamicResource IdentityConfig.Uuid}" />
                            </ComboBox>
                            <Button x:Name="PreviewIdentityConfigButton" Content="{DynamicResource IdentityConfig.Generate}" Command="{Binding PreviewIdentityConfigCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <DataGrid x:Name="ConfigPreviewTable" ItemsSource="{Binding ConfigChanges}" MaxHeight="180">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Impact}" /></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Column.Key}" Binding="{Binding Key}" Width="150" />
                                <DataGridTextColumn Header="{DynamicResource Config.Before}" Binding="{Binding Before}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Config.After}" Binding="{Binding After}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Config.Impact}" Binding="{Binding Impact}" Width="*" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button x:Name="ReviewConfigButton" Content="{DynamicResource Config.Review}" Command="{Binding ReviewConfigCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding UnsavedHistoryWarning}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Expander x:Name="IdentityExperimentExpander" Grid.Row="3" Header="{DynamicResource Experiment.Title}" Margin="0,0,0,18">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel>
                        <TextBlock Text="{DynamicResource Experiment.Description}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                        <WrapPanel Margin="0,0,0,12">
                            <ComboBox x:Name="ExperimentSelector" SelectedIndex="{Binding SelectedExperimentIndex}" IsEnabled="{Binding CanChooseExperiment}" MinWidth="230" Padding="7,5" Margin="0,0,12,8">
                                <ComboBoxItem Content="{DynamicResource Experiment.Mac}" />
                                <ComboBoxItem Content="{DynamicResource Experiment.Uuid}" />
                            </ComboBox>
                            <Button x:Name="PreviewExperimentButton" Content="{DynamicResource Experiment.Preview}" Command="{Binding PreviewExperimentCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock x:Name="ExperimentNotice" Text="{Binding ExperimentNotice}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{DynamicResource Experiment.Target}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExperimentTarget}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                        <DataGrid x:Name="ExperimentChangesTable" ItemsSource="{Binding ExperimentChanges}" MaxHeight="160" RowHeight="72" Margin="0,0,0,12">
                            <DataGrid.Resources><Style x:Key="ExperimentCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextTrimming" Value="None" /></Style></DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Key}" Width="160" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{DynamicResource Config.Before}" Binding="{Binding Before}" Width="150" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{DynamicResource Experiment.Intent}" Binding="{Binding After}" Width="*" ElementStyle="{StaticResource ExperimentCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{DynamicResource Experiment.Basis}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExperimentBasis}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                        <TextBlock Text="{DynamicResource Experiment.Constraints}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExperimentConstraints}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                        <TextBlock Text="{DynamicResource Experiment.Risk}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExperimentRisk}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                        <TextBlock Text="{DynamicResource Experiment.Recovery}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExperimentRecovery}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                        <TextBlock Text="{DynamicResource Experiment.Gaps}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExperimentGaps}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                        <CheckBox x:Name="ExperimentReviewCheckBox" IsChecked="{Binding ExperimentReviewed}" IsEnabled="{Binding CanReviewExperiment}" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Experiment.Review}" TextWrapping="Wrap" />
                        </CheckBox>
                        <Button x:Name="ExportExperimentButton" Content="{DynamicResource Experiment.Export}" Command="{Binding ExportExperimentCommand}" HorizontalAlignment="Left" Margin="0" />
                    </StackPanel></Border>
                </Expander>
                <Expander x:Name="BackupHistoryExpander" Grid.Row="4" Header="{DynamicResource History.Title}" Margin="0,0,0,12">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding HistoryNotice}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <DataGrid x:Name="BackupHistoryTable" ItemsSource="{Binding BackupHistory}" SelectedItem="{Binding SelectedBackup}" MaxHeight="120">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Backup}" /></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource History.Time}" Binding="{Binding Time}" Width="180" />
                                <DataGridTextColumn Header="{DynamicResource History.Target}" Binding="{Binding Target}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource History.Operation}" Binding="{Binding Operation}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,8">
                            <Button Content="{DynamicResource History.Reload}" Command="{Binding LoadHistoryCommand}" />
                            <Button Content="{DynamicResource History.PreviewRestore}" Command="{Binding PreviewRestoreCommand}" />
                            <Button Content="{DynamicResource History.Save}" Command="{Binding SaveHistoryCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource History.Location}" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding RecoveryLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="65" />
                    </StackPanel>
                </Expander>
                <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="VmxTable" ItemsSource="{Binding VmxRows}" MaxHeight="280"><DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Column.Key}" Binding="{Binding Key}" Width="230" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Value}" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Support}" Binding="{Binding Support}" Width="280" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns></DataGrid></Border>
            </Grid></ScrollViewer>
            <TabControl Grid.Row="1" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
            <TabItem Header="{DynamicResource Validation.TwoReports}"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Comparison.Description}" Style="{StaticResource Muted}" Margin="0,0,0,18" />
                <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><Button Content="{DynamicResource Action.ImportLeft}" Command="{Binding ImportLeftCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding LeftText}" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><Button Content="{DynamicResource Action.ImportRight}" Command="{Binding ImportRightCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding RightText}" Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="DifferencesTable" ItemsSource="{Binding Differences}"><DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name}" Width="175" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Left}" Binding="{Binding Left}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Right}" Binding="{Binding Right}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Result}" Binding="{Binding Result}" Width="130" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{DynamicResource Column.Reason}" Binding="{Binding Reason}" Width="160" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns></DataGrid></Border>
            </Grid></TabItem>
            <TabItem x:Name="IdentityValidationTab" Header="{DynamicResource Validation.Title}">
                <ScrollViewer x:Name="ValidationScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource Validation.Description}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ValidationNotice}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                    <ComboBox x:Name="ValidationFieldSelector" SelectedIndex="{Binding SelectedValidationFieldIndex}" IsEnabled="{Binding CanChooseIdentifiers}" HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,12">
                        <ComboBoxItem Content="{DynamicResource IdentityConfig.Mac}" /><ComboBoxItem Content="{DynamicResource IdentityConfig.Uuid}" />
                    </ComboBox>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
                        <Button Content="{DynamicResource Validation.ImportBefore}" Command="{Binding ImportValidationBeforeCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ValidationBeforeText}" Style="{StaticResource Muted}" Margin="0,4,0,8" />
                        <Button Content="{DynamicResource Validation.ImportAfter}" Command="{Binding ImportValidationAfterCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ValidationAfterText}" Style="{StaticResource Muted}" Margin="0,4,0,8" />
                        <Button Content="{DynamicResource Validation.ImportRestored}" Command="{Binding ImportValidationRestoredCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ValidationRestoredText}" Style="{StaticResource Muted}" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="{DynamicResource Validation.RecordNote}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <WrapPanel><Button Content="{DynamicResource Validation.ApplyRecord}" Command="{Binding ImportValidationApplyCommand}" />
                            <Button Content="{DynamicResource Validation.RestoreRecord}" Command="{Binding ImportValidationRestoreCommand}" /></WrapPanel>
                        <TextBlock Text="{Binding ValidationRecordsText}" Style="{StaticResource Muted}" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12"><DataGrid x:Name="ValidationChecksTable" ItemsSource="{Binding ValidationChecks}" MaxHeight="400"><DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Validation.Layer}" Binding="{Binding Layer}" Width="130" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Check}" Width="155" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Column.Result}" Binding="{Binding State}" Width="100" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Column.Reason}" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Validation.Before}" Binding="{Binding Before}" Width="88" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Validation.After}" Binding="{Binding After}" Width="88" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Validation.Restored}" Binding="{Binding Restored}" Width="88" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns></DataGrid></Border>
                    <TextBlock Text="{DynamicResource Validation.ProgramNote}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12"><DataGrid x:Name="ValidationProgramTable" ItemsSource="{Binding ValidationProgram}"><DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Validation.Phase}" Binding="{Binding Phase}" Width="120" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Validation.Time}" Binding="{Binding Time}" Width="220" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Validation.Program}" Binding="{Binding Evidence}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Hypervisor" Binding="{Binding Hypervisor}" Width="120" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns></DataGrid></Border>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="{DynamicResource Validation.ExportJson}" Command="{Binding ExportValidationJsonCommand}" />
                        <Button Content="{DynamicResource Validation.ExportHtml}" Command="{Binding ExportValidationHtmlCommand}" />
                        <Button Content="{DynamicResource Validation.Clear}" Command="{Binding ClearValidationCommand}" />
                    </WrapPanel>
                    <Expander x:Name="ValidationCaptureExpander" Header="{DynamicResource Validation.Capture}"><StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Validation.CaptureNote}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{DynamicResource Validation.Session}" Margin="0,10,0,4" />
                        <TextBox x:Name="ValidationSessionInput" Text="{Binding ValidationSession, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChooseIdentifiers}" />
                        <TextBlock Text="{DynamicResource Validation.Adapter}" Margin="0,10,0,4" />
                        <TextBox x:Name="ValidationAdapterInput" Text="{Binding ValidationAdapter, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChooseIdentifiers}" />
                        <TextBlock Text="{DynamicResource Validation.AdapterNote}" Style="{StaticResource Muted}" Margin="0,4,0,4" />
                        <ComboBox x:Name="ValidationCapturePhase" SelectedIndex="{Binding SelectedValidationCapturePhase}" IsEnabled="{Binding CanChooseIdentifiers}" Margin="0,8,0,8">
                            <ComboBoxItem Content="{DynamicResource Validation.Before}" /><ComboBoxItem Content="{DynamicResource Validation.After}" /><ComboBoxItem Content="{DynamicResource Validation.Restored}" />
                        </ComboBox>
                        <Button Content="{DynamicResource Validation.Capture}" Command="{Binding CapturePrivateValidationCommand}" HorizontalAlignment="Left" />
                    </StackPanel></Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
            </TabControl>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=4}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Reports.Description}" Style="{StaticResource Muted}" Margin="0,0,0,22" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource Reports.Format}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,10" /><TextBlock Text="{Binding ReportDetails}" Style="{StaticResource Muted}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource Reports.Json}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" /><Button Content="{DynamicResource Action.ExportJson}" Command="{Binding ExportJsonCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource Reports.Html}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" /><Button Content="{DynamicResource Action.ExportHtml}" Command="{Binding ExportHtmlCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource Experiment.Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" /><TextBlock Text="{DynamicResource Experiment.ReportNote}" Style="{StaticResource Muted}" Margin="0,0,0,12" /><Button Content="{DynamicResource Experiment.Export}" Command="{Binding ExportExperimentCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Reports.Privacy}" FontWeight="SemiBold" Margin="0,0,0,10" /><TextBlock Text="{DynamicResource Reports.PrivacyText}" Style="{StaticResource Muted}" /></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#DEE6F0" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0">
                <DockPanel><TextBlock Text="{Binding ApplicationVersion}" Foreground="#8798AD" FontSize="11" DockPanel.Dock="Right" /><TextBlock Text="{Binding StatusText}" Foreground="#62748B" FontSize="12" TextWrapping="Wrap" /></DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
